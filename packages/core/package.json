{
  "name": "@biopixi/core",
  "version": "0.1.0",
  "description": "Offline pixi portability grading and BioContainers target naming",
  "type": "module",
  "sideEffects": false,
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "data",
    "README.md"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/jmchilton/biopixi.git",
    "directory": "packages/core"
  },
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "scripts": {
    "build": "tsc",
    "typecheck": "tsc --noEmit",
    "test": "tsc --noEmit && vitest run",
    "test:watch": "vitest",
    "lint": "eslint src/ test/",
    "format": "prettier --check 'src/**/*.ts' 'test/**/*.ts'",
    "format-fix": "prettier --write 'src/**/*.ts' 'test/**/*.ts'",
    "lint:pkg": "publint",
    "check:types": "attw --pack . --profile esm-only"
  },
  "dependencies": {
    "smol-toml": "^1.7.1",
    "yaml": "^2.8.3"
  },
  "devDependencies": {
    "@types/node": "^25.5.0"
  }
}
