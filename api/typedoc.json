			"readme": [
				{
					"kind": "text",
					"text": "# @biopixi/cli\n\nThe "
				},
				{
					"kind": "code",
					"text": "`biopixi`"
				},
				{
					"kind": "text",
					"text": " command-line interface.\n\n## Installation\n\n"
				},
				{
					"kind": "code",
					"text": "```bash\nnpm install --global @biopixi/cli\n```"
				},
				{
					"kind": "text",
					"text": "\n\n## Usage\n\n"
				},
				{
					"kind": "code",
					"text": "```bash\nbiopixi grade .\nbiopixi grade project-a project-b --min-level 3\n```"
				},
				{
					"kind": "text",
					"text": "\n\nWithout an explicit directory, "
				},
				{
					"kind": "code",
					"text": "`biopixi grade`"
				},
				{
					"kind": "text",
					"text": " grades the current directory."
				}
			]
		},
